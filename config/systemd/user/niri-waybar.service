[Unit]
Description=GNOME-style top bar (niri session)
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
ExecStart=/usr/bin/waybar -c %h/.config/niri/waybar/config.jsonc -s %h/.config/niri/waybar/style.css
Restart=on-failure
RestartSec=1

[Install]
WantedBy=niri.service
