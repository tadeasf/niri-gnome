[Unit]
Description=Automount USB drives, like GNOME does (niri session)
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
# mounts under /run/media/$USER and says so through mako; no tray icon
ExecStart=/usr/bin/udiskie --automount --notify --no-tray
Restart=on-failure
RestartSec=1

[Install]
WantedBy=niri.service
