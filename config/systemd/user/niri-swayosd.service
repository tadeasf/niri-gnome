[Unit]
Description=Volume/brightness OSD (niri session)
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
ExecStart=/usr/bin/swayosd-server -s %h/.config/niri/swayosd/style.css
Restart=on-failure
RestartSec=1

[Install]
WantedBy=niri.service
