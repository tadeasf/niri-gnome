[Unit]
Description=Blurred wallpaper for the overview backdrop (niri session)
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
ExecStartPre=%h/.config/niri/backdrop.sh prepare
# layer namespace "awww-daemonbackdrop", which the niri layer-rule puts in the overview backdrop
ExecStart=/usr/bin/awww-daemon --namespace backdrop
ExecStartPost=%h/.config/niri/backdrop.sh show
Restart=on-failure
RestartSec=1

[Install]
WantedBy=niri.service
