// niri-gnome: a niri session that feels like a clean, black-and-white GNOME.
// Reference for every option: https://niri-wm.github.io/niri/Configuration:-Introduction
// Check edits with `niri validate`; niri reloads this file the moment it's saved.

input {
    keyboard {
        xkb {
            // switched with Super+Space, shown in the bar
            layout "us,cz"
        }
        numlock
    }

    touchpad {
        tap
        natural-scroll
    }

    mouse {
        // same as GNOME: org.gnome.desktop.peripherals.mouse speed / accel-profile / natural-scroll
        natural-scroll
        accel-speed -0.47448559670781887
        accel-profile "flat"
    }
}

output "HDMI-A-2" {
    mode "3440x1440@99.982"
}

output "eDP-1" {
    scale 1.25
}

layout {
    // transparent so the swaybg wallpaper (a background layer) shows through on every workspace
    background-color "transparent"

    // no gaps: every pixel goes to windows
    gaps 0

    // Super+R cycles these
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    // GNOME has no focus outline. A border instead of the focus ring, because the ring is drawn
    // outside the window and the neighbours cover it when there are no gaps.
    focus-ring {
        off
    }

    // thin white on the focused window, near-black divider on the rest
    border {
        width 2
        active-color "#ffffff"
        inactive-color "#1a1a1a"
        urgent-color "#9b0000"
    }

    // Tabbed columns (Super+W): a thin segmented strip across the top, one segment per tab,
    // white for the shown tab like the focused border. Inside the column, so it never covers neighbours.
    tab-indicator {
        hide-when-single-tab
        place-within-column
        position "top"
        width 3
        gap 0
        length total-proportion=1.0
        gaps-between-tabs 2
        active-color "#ffffff"
        inactive-color "#4a4a4a"
        urgent-color "#9b0000"
    }

    // Off for tiled windows; the floating-window rule below turns it on with these values.
    shadow {
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }
}

// waybar, niri-switcher, niri-panels, swaybg, the overview backdrop, swayosd and udiskie run as systemd
// user units (config/systemd/user/niri-*.service) so they restart if they crash; they're
// WantedBy=niri.service and never start in GNOME.
// GNOME Shell is the polkit agent under GNOME; niri needs its own or pkexec prompts never show
// Fedora/Debian/openSUSE install it in /usr/libexec, Arch in /usr/lib/mate-polkit
spawn-sh-at-startup "for a in /usr/libexec/polkit-mate-authentication-agent-1 /usr/lib/mate-polkit/polkit-mate-authentication-agent-1; do [ -x \"$a\" ] && exec \"$a\"; done"

// Super+Shift+/ still opens it
hotkey-overlay {
    skip-at-startup
}

// tiled GTK/libadwaita apps drop rounded corners and shadows, so the 2px border hugs them
// (apps need a restart to pick up a change here)
prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

cursor {
    xcursor-theme "Bibata-Modern-Ice"
    xcursor-size 24
}

// Fixed 4 workspaces like GNOME; named workspaces persist even when empty.
workspace "1"
workspace "2"
workspace "3"
workspace "4"

// Firefox/Zen picture-in-picture player floats (host "firefox" and Flatpak "org.mozilla.firefox").
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// Floating windows (dialogs, picture-in-picture, Super+V) get a soft shadow so they read as "on top";
// tiled windows stay flat and edge-to-edge. Values come from layout { shadow }.
window-rule {
    match is-floating=true
    shadow { on; }
}

// Overview (Super+A) backdrop: the blurred wallpaper from niri-backdrop.service (awww, namespace
// "backdrop"). swaybg stays on the workspaces, so they look like cards floating over a soft blur.
layer-rule {
    match namespace="^awww-daemonbackdrop$"
    place-within-backdrop true
}

// GNOME-style binds. Alt/Super+Tab and Alt+` use niri-switcher; niri's built-in preview switcher stays on Mod+`.
binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Launchers and apps (GNOME custom shortcuts)
    Mod+D hotkey-overlay-title="Launcher: rofi (ArcMenu look)" { spawn-sh "rofi -show drun -config ~/.config/niri/rofi/arcmenu.rasi"; }
    Alt+F2 hotkey-overlay-title=null { spawn-sh "rofi -show drun -config ~/.config/niri/rofi/arcmenu.rasi"; }

    // GNOME-style app switcher (~/.config/niri/switcher): icons grouped by app, Down = window previews
    Alt+Tab hotkey-overlay-title="Switch applications" { spawn "gdbus" "call" "--session" "--dest" "io.github.tadeasf.NiriSwitcher" "--object-path" "/io/github/tadeasf/NiriSwitcher" "--method" "org.gtk.Actions.Activate" "next" "[]" "{}"; }
    Alt+Shift+Tab { spawn "gdbus" "call" "--session" "--dest" "io.github.tadeasf.NiriSwitcher" "--object-path" "/io/github/tadeasf/NiriSwitcher" "--method" "org.gtk.Actions.Activate" "prev" "[]" "{}"; }
    Mod+Tab hotkey-overlay-title=null { spawn "gdbus" "call" "--session" "--dest" "io.github.tadeasf.NiriSwitcher" "--object-path" "/io/github/tadeasf/NiriSwitcher" "--method" "org.gtk.Actions.Activate" "next" "[]" "{}"; }
    Mod+Shift+Tab { spawn "gdbus" "call" "--session" "--dest" "io.github.tadeasf.NiriSwitcher" "--object-path" "/io/github/tadeasf/NiriSwitcher" "--method" "org.gtk.Actions.Activate" "prev" "[]" "{}"; }
    Alt+grave hotkey-overlay-title="Switch windows of the app" { spawn "gdbus" "call" "--session" "--dest" "io.github.tadeasf.NiriSwitcher" "--object-path" "/io/github/tadeasf/NiriSwitcher" "--method" "org.gtk.Actions.Activate" "window" "[]" "{}"; }
    Alt+Shift+grave { spawn "gdbus" "call" "--session" "--dest" "io.github.tadeasf.NiriSwitcher" "--object-path" "/io/github/tadeasf/NiriSwitcher" "--method" "org.gtk.Actions.Activate" "prev-window" "[]" "{}"; }
    Mod+Return hotkey-overlay-title="Terminal: ghostty" { spawn "ghostty"; }
    Mod+Ctrl+Return hotkey-overlay-title="Terminal: alacritty" { spawn "alacritty"; }
    Mod+Shift+Return hotkey-overlay-title="Terminal: kitty" { spawn "kitty"; }
    Ctrl+Shift+Return hotkey-overlay-title="mpv playlists" { spawn-sh "cd ~/playlists && mpv --idle --force-window=yes"; }
    Mod+Shift+O hotkey-overlay-title="CopyQ" { spawn "copyq" "show"; }
    Mod+Escape allow-inhibiting=false hotkey-overlay-title="Lock the Screen" { spawn-sh "~/.config/niri/lock.sh"; }
    Super+Alt+S allow-when-locked=true hotkey-overlay-title=null { spawn-sh "pkill orca || exec orca"; }

    // Media keys
    // swayosd shows a GNOME-style pill; same 6% step and 100% cap as before
    XF86AudioRaiseVolume allow-when-locked=true { spawn "swayosd-client" "--output-volume" "+6" "--max-volume" "100"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "swayosd-client" "--output-volume" "-6"; }
    XF86AudioMute        allow-when-locked=true { spawn "swayosd-client" "--output-volume" "mute-toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "swayosd-client" "--input-volume" "mute-toggle"; }
    XF86AudioPlay        allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioPause       allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop        allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev        allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext        allow-when-locked=true { spawn-sh "playerctl next"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "swayosd-client" "--brightness" "+10"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "swayosd-client" "--brightness" "-10"; }

    // Window management
    Mod+A repeat=false { toggle-overview; }
    Mod+O repeat=false { toggle-overview; }
    Mod+Q repeat=false { close-window; }
    Mod+F { fullscreen-window; }
    Alt+F10 { maximize-column; }

    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-or-workspace-up; }
    Mod+Down  { focus-window-or-workspace-down; }

    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up-or-to-workspace-up; }
    Mod+Shift+Down  { move-window-down-or-to-workspace-down; }

    Mod+1 { focus-workspace "1"; }
    Mod+2 { focus-workspace "2"; }
    Mod+3 { focus-workspace "3"; }
    Mod+4 { focus-workspace "4"; }
    Mod+Shift+1 { move-column-to-workspace "1"; }
    Mod+Shift+2 { move-column-to-workspace "2"; }
    Mod+Shift+3 { move-column-to-workspace "3"; }
    Mod+Shift+4 { move-column-to-workspace "4"; }

    Mod+Space       { switch-layout "next"; }
    Mod+Shift+Space { switch-layout "prev"; }

    // niri extras (no GNOME equivalent, no clashes)
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }
    Mod+WheelScrollRight { focus-column-right; }
    Mod+WheelScrollLeft  { focus-column-left; }
    Mod+Shift+WheelScrollDown { focus-column-right; }
    Mod+Shift+WheelScrollUp   { focus-column-left; }

    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    // pull the next column's window into this column (a new tab) / push the focused one back out
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+C { center-column; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+W { toggle-column-tabbed-display; }

    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    Mod+Shift+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Ctrl+Alt+Delete { quit; }
    Mod+Shift+E { quit; }
}
