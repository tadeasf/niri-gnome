/* ArcMenu "Runner" look-alike for niri (GNOME: runner, 600px, centred, pill search r=25,
   list view, frequent apps, extra details). drun history = frequent apps first. */
configuration {
    modi: "drun";
    show-icons: true;
    icon-theme: "Colloid-Grey-Dark";
    terminal: "ghostty";
    markup-rows: true;
    drun-display-format: "{name}\n<span size='small' weight='normal' alpha='55%'>{comment}</span>";
    drun-match-fields: "name,generic,comment,keywords,exec";
    matching: "fuzzy";
    sort: true;
    sorting-method: "fzf";
}

* {
    font: "Fira Sans Semi-Bold 11";
    bg: #242424;
    field: #383838;
    sel: #3a3a3a;
    fg: #ffffff;
    dim: #ffffff80;
    background-color: transparent;
    text-color: @fg;
}

window {
    location: center;
    anchor: center;
    width: 600px;
    background-color: @bg;
    border: 1px;
    border-color: #363636;
    border-radius: 18px;
    padding: 14px;
}
mainbox { children: [ inputbar, listview ]; spacing: 12px; }

inputbar {
    children: [ icon-search, entry ];
    background-color: @field;
    border-radius: 25px;
    padding: 9px 16px;
    spacing: 10px;
}
icon-search {
    expand: false;
    filename: "system-search-symbolic";
    size: 16px;
    vertical-align: 0.5;
}
entry {
    placeholder: "Type to search…";
    placeholder-color: @dim;
    // rofi's entry ignores the inherited text-color and types in its default blue
    text-color: @fg;
    cursor-color: @fg;
    cursor: text;
    vertical-align: 0.5;
}

listview {
    lines: 7;
    fixed-height: false;
    dynamic: true;
    scrollbar: false;
    spacing: 2px;
}
element {
    padding: 7px 10px;
    spacing: 12px;
    border-radius: 12px;
    text-color: @fg;
}
element normal.normal, element alternate.normal, element normal.active, element alternate.active { background-color: transparent; text-color: @fg; }
element selected.normal, element selected.active { background-color: @sel; text-color: @fg; }
element-icon { size: 32px; vertical-align: 0.5; }
element-text { vertical-align: 0.5; text-color: inherit; }
