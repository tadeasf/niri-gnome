// GNOME-top-bar look for niri: workspaces left, clock centre, status right.
{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 0,
    "modules-left": ["niri/workspaces"],
    "modules-center": ["custom/clock"],
    "modules-right": ["tray", "network", "pulseaudio", "custom/power"],

    "niri/workspaces": { "format": "" },
    // waybar's chrono formatter rejects %-d/%-I, so GNOME's unpadded 12h clock comes from date
    "custom/clock": {
        "exec": "date '+%a %b %-d  %-I:%M %p'",
        "interval": 5,
        "tooltip": false
    },
    "tray": { "icon-size": 16, "spacing": 10 },
    "network": {
        "format-wifi": "󰤨",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤭",
        "tooltip-format": "{ifname}  {ipaddr}",
        "on-click": "nm-connection-editor"
    },
    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
        "tooltip-format": "{volume}%",
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "printf 'Lock\\nLog out\\nSuspend\\nReboot\\nPower off\\n' | fuzzel --dmenu | { read c; case \"$c\" in Lock) swaylock -f;; 'Log out') niri msg action quit -s;; Suspend) systemctl suspend;; Reboot) systemctl reboot;; 'Power off') systemctl poweroff;; esac; }"
    }
}
