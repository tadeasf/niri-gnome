// GNOME-top-bar look for niri: workspaces left, clock centre, live stats + power right.
{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 0,
    "modules-left": ["niri/workspaces", "mpris"],
    "modules-center": ["custom/clock"],
    "modules-right": ["tray", "niri/language", "custom/stats", "custom/power"],

    "niri/workspaces": { "format": "" },
    // waybar's chrono formatter rejects %-d/%-I, so GNOME's unpadded 12h clock comes from date
    "custom/clock": {
        "exec": "date '+%a %b %-d  %-I:%M %p'",
        "interval": 5,
        "tooltip": false,
        "on-click": "gdbus call --session --dest io.github.tadeasf.NiriPanels --object-path /io/github/tadeasf/NiriPanels --method org.gtk.Actions.Activate calendar '[]' '{}'"
    },
    "tray": { "icon-size": 16, "spacing": 10 },
    // keyboard layout (us/cz), the one Super+Space switches; click cycles it too
    "niri/language": {
        "format": "{short}",
        "on-click": "niri msg action switch-layout next"
    },
    // now playing (YouTube in the browser, music apps): follows the active player via playerctld,
    // left side so the clock stays centred; hidden when nothing is playing or paused
    "mpris": {
        "format": "{status_icon}  {dynamic}",
        "dynamic-order": ["title", "artist"],
        "dynamic-separator": "  ·  ",
        "title-len": 45,
        "artist-len": 20,
        "dynamic-len": 60,
        "status-icons": { "playing": "\uf04b", "paused": "\uf04c", "stopped": "\uf04d" },
        "tooltip-format": "{player}: {title} - {artist}"
    },
    // network name + speed, CPU, RAM, GPU; one long-running script, refreshed every 2 s
    "custom/stats": {
        "exec": "~/.config/niri/waybar/stats.py",
        "return-type": "json",
        "escape": false,
        "on-click": "command -v resources >/dev/null && exec resources || exec gnome-system-monitor"
    },
    // quick settings: volume, network/bluetooth/DND toggles, screenshot, settings, lock, power off
    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "gdbus call --session --dest io.github.tadeasf.NiriPanels --object-path /io/github/tadeasf/NiriPanels --method org.gtk.Actions.Activate quick '[]' '{}'"
    }
}
