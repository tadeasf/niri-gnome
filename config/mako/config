# niri-only (GNOME uses its own notifications); monochrome like the GNOME banners
font=Fira Sans Semi-Bold 11
background-color=#1e1e1ef5
text-color=#ffffffff
border-color=#2e2e2eff
progress-color=over #3a3a3aff
border-size=1
border-radius=12
padding=12,16
margin=12
width=380
icons=1
max-icon-size=32
anchor=top-center
default-timeout=6000
# the clock menu lists past notifications from this history
max-history=50

[mode=do-not-disturb]
invisible=1
